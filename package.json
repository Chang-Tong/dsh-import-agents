{
  "name": "dsh-import-agents",
  "version": "0.2.0",
  "description": "Import pi / opencode sessions, chat history, and agents into DeepSeek Harness (dsh): slash commands, session-start migration prompt, and a one-click Sync button in the composer.",
  "type": "module",
  "main": "plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/",
    "plugin/",
    "src/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "import": "node import.mjs",
    "export": "node export.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/dsh-commands": ">=0.1.0",
    "@deepseek-ai/dsh-session": ">=0.1.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0",
    "@deepseek-ai/dsh-user-questions": ">=0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
